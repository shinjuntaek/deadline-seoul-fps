{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --ignore-scripts --no-audit"
  },
  "deploy": {
    "startCommand": "node multiplayer/server.mjs",
    "healthcheckPath": "/api/multiplayer",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
